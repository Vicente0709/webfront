---
import Navbar from "../components/navbar.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Zelify — Business Finances</title>
  </head>

  <body
    style="
      background-color: #020b18;
      background-image: url('/images/FONDO%201.jpg');
      background-size: cover;
      background-position: center;
      min-height: 100vh;
      margin: 0;
    "
  >
    <Navbar />

    <section class="hero">
      <div class="hero-content">
        <h2 class="subtitle">The New Standard in</h2>
        <h1 class="title">Business<br />Finances</h1>
        <p class="description">
          Zelify simplifies business finance: connecting payments, credit, and
          cash flow in one smart platform.
        </p>
        <a href="/" class="btn-primary">Let’s start</a>
      </div>
    </section>
  </body>
</html>

<style>
  @font-face {
    font-family: "NataSans";
    src: url("/fonts/NataSans-VariableFont_wght.ttf") format("truetype");
    font-weight: 100 900;
    font-display: swap;
  }

  body {
    font-family: "NataSans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #fff;
  }

  .hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    padding: 4rem 8%;
    min-height: 100vh;
  }

  .hero-content {
    max-width: 600px;
  }

  .subtitle {
    font-size: 1.8rem;
    font-weight: 600;
    color: #6AFF00;
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: 4.5rem;
    font-weight: 800;
    line-height: 1.1;
    color: #f8f9fa;
    margin-bottom: 1.5rem;
  }

  .description {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #ced4da;
    margin-bottom: 2rem;
  }

  .btn-primary {
    background-color: #6AFF00;
    color: #0d1117;
    text-decoration: none;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    display: inline-block;
    transition: background-color 0.2s ease;
  }

  .btn-primary:hover {
    background-color: #6AFF00;
  }
</style>